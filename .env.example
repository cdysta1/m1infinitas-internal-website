# Appwrite Cloud 配置
VITE_APPWRITE_ENDPOINT=https://cloud.appwrite.io/v1
VITE_APPWRITE_PROJECT_ID=your_project_id
VITE_APPWRITE_DATABASE_ID=your_database_id
VITE_APPWRITE_BUCKET_ID=your_bucket_id

# Collection IDs（Appwrite 控制台创建后填入）
VITE_APPWRITE_COLLECTION_PROFILES=profiles
VITE_APPWRITE_COLLECTION_PROJECTS=projects
VITE_APPWRITE_COLLECTION_UPDATES=updates

# 内部邀请码（注册校验用，构建时会打入前端 bundle）
VITE_INVITE_CODE=change_me

# 部署子路径：
# - 本地开发保持 / 即可（Vite dev server 从根路径提供服务）
# - GitHub Pages 项目站（repo 名非 <username>.github.io）需设置为 /<repo-name>/
#   例如：VITE_BASE_PATH=/m1infinitas-internal.github.io/
# - 生产环境通过 GitHub Repo Variables 注入，不依赖此文件
VITE_BASE_PATH=/
